# ======================================================================
# Exemplo de variáveis de ambiente. Copie para .env e ajuste os valores.
# O .env NÃO vai para o git nem para a imagem Docker (passado em runtime).
# ======================================================================

# --- Django ---
# OBRIGATÓRIA. Gere uma chave segura (sem #, $, aspas) com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cole-uma-chave-aleatoria-url-safe-aqui

# Em produção/container: False. Em dev local pode deixar True (ou omitir).
DEBUG=False

# Domínios/IPs que servem a aplicação (separados por vírgula).
ALLOWED_HOSTS=localhost,127.0.0.1,SEU_IP_INTERNO

# Origens confiáveis para CSRF — use o MESMO esquema/porta do acesso.
# HTTP por IP:porta (rede interna):  http://SEU_IP_INTERNO:8004
# HTTPS por domínio:                 https://seu-dominio.com.br
CSRF_TRUSTED_ORIGINS=http://SEU_IP_INTERNO:8004

# HTTPS habilitado? Deixe False enquanto acessar por HTTP (cookies Secure/SSL/HSTS
# só funcionam sob TLS). Mude para True quando o nginx estiver servindo HTTPS.
HTTPS_ENABLED=False

# Roda 'migrate' automaticamente no start do container (true/false).
AUTO_MIGRATE=true

# --- Oracle 19c (thin mode) ---
ORACLE_HOST=SEU_IP_ORACLE
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=SEU_SERVICE_NAME
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
